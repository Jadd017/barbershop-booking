# `npm run dev` / `npm run build` on the multi-barber branch: the Firebase emulator only.
# "demo-" project IDs can never reach a real Firebase project (see docs/ARCHITECTURE.md, 3.2).
# Every variable is set here, so nothing from .env.local (Eddy's real project) leaks through.
VITE_USE_EMULATOR=true
VITE_SHOP_NAME=Demo Barbershop
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-barbershop.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-barbershop
VITE_FIREBASE_STORAGE_BUCKET=demo-barbershop.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
