# A shop's config (README, "Adding a new shop"). `npm run new-shop -- <shop> sassine-barbershop` copies
# this to shops/<shop>/.env and fills in the project ID and its default domains. Committed: the
# Firebase web config is public by design (the security rules protect the data).
#
# Firebase console → Project settings → General → Your apps → the web app → SDK setup and
# configuration → Config. Copy each value without quotes.
VITE_FIREBASE_API_KEY=AIzaSyA7XxvB2ZCSFs4kzmo-D6sdV2Y2tHrB99w
# The domain the site is served from (Google sign-in on phones needs it): sassine-barbershop.web.app,
# or the shop's own domain once it's connected in Firebase Hosting.
VITE_FIREBASE_AUTH_DOMAIN=sassine-barbershop.web.app
VITE_FIREBASE_PROJECT_ID=sassine-barbershop
VITE_FIREBASE_STORAGE_BUCKET=sassine-barbershop.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=129075704168
VITE_FIREBASE_APP_ID=1:129075704168:web:ae19b2d5178d2b7ecda6dd

# App Check (optional, docs/DEVELOPMENT.md, "App Check"): the reCAPTCHA Enterprise site key, which
# is public. Empty: App Check off.
VITE_RECAPTCHA_ENTERPRISE_KEY=

# The shop's name the first time (shop settings are created with it; the owner changes it in
# Settings → Shop) and in link previews (WhatsApp, Instagram), which only change on a redeploy.
VITE_SHOP_NAME=Sassine Maatouk
# The site's address, for link previews: https://sassine-barbershop.web.app or the shop's own domain.
VITE_SITE_URL=https://sassine-barbershop.web.app
