{
  "name": "barbershop-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode emulator",
    "build": "tsc -b && vite build --mode emulator",
    "lint": "oxlint",
    "preview": "vite preview --mode emulator",
    "deploy": "node scripts/deploy.mjs",
    "new-shop": "node scripts/new-shop.mjs",
    "setup-shop": "node scripts/setup-shop.mjs",
    "emu": "firebase emulators:start --project demo-barbershop --only auth,firestore",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:emu": "firebase emulators:exec --project demo-barbershop --only auth,firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:rules": "npm run test:emu"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "firebase": "^13.0.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "license": "MIT"
}
