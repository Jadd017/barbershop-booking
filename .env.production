# Used by `npm run build` (on top of .env.local). Production is served from Firebase Hosting, and
# Google sign-in's redirect only works on mobile when the auth domain is the site's own domain.
# `npm run dev` keeps the .env.local value.
VITE_FIREBASE_AUTH_DOMAIN=eddy-barbershop.web.app
# App Check reCAPTCHA Enterprise site key (public; see README, "App Check"). Empty: App Check off.
VITE_RECAPTCHA_ENTERPRISE_KEY=
