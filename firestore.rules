rules_version = '2';

// Server-side checks for the booking site. The page validates too, but only these rules count.
//
// Customers sign in with Google to book; Eddy signs in with email/password.
//
// Collections (see src/data/api.ts):
// - bookings/{bookingCode}   full booking. Customers can read and cancel only their own (customerUid);
//                            Eddy can read everything. Walk-ins Eddy adds have customerUid null.
// - slots/{date}_{HHMM}      one doc per taken 15-min slot; no personal info, readable by all.
// - phoneLimits/{phone}_{n}  n = 1 or 2: the two "seats" a phone number can hold. Each points at the
//                            booking using it. A seat is free again once that booking has started or
//                            is no longer "booked", so a phone can't hold more than 2 future bookings.
// - userLimits/{uid}_{n}     the same two seats per Google account.
// - customers/{uid}          the name and phone last used, to pre-fill the form. Only they and Eddy read it.
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with ADMIN_UID in src/config.ts.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'HHBoRoG4jphMLu2OjKpYTGJTKd42';
    }

    // A customer signed in with Google (not Eddy's email account, nor any other sign-in method).
    function isCustomer() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // The signed-in customer owns booking `b`.
    function ownsBooking(b) {
      return isCustomer() && b.customerUid == request.auth.uid;
    }

    // Keep in sync with the services in src/data/fakeData.ts.
    function services() {
      return {
        'haircut': { 'name': 'Haircut', 'duration': 30 },
        'beard': { 'name': 'Beard', 'duration': 15 },
        'haircut-beard': { 'name': 'Haircut + Beard', 'duration': 45 }
      };
    }

    // DAYS_TO_SHOW in src/config.ts: today plus the next 3 days.
    function daysToShow() {
      return 4;
    }

    function bookingPath(id) {
      return /databases/$(database)/documents/bookings/$(id);
    }

    function slotPath(id) {
      return /databases/$(database)/documents/slots/$(id);
    }

    // "12:30" -> 750
    function minutesOf(time) {
      return int(time.split(':')[0]) * 60 + int(time.split(':')[1]);
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // ("2026-10-22", 750) -> "2026-10-22_1230", the ID of that slot doc.
    function slotIdAt(date, minutes) {
      return date + '_' + pad2(minutes / 60) + pad2(minutes % 60);
    }

    // ID of the i-th 15-min slot booking `b` occupies.
    function nthSlotId(b, i) {
      return slotIdAt(b.date, minutesOf(b.startTime) + i * 15);
    }

    // True if `b` has no i-th slot, or that slot doc ends up pointing at booking `id`.
    // Services are at most 60 min (4 slots); add a line in slotsClaimed for longer ones.
    function slotClaimed(b, id, i) {
      return i * 15 >= b.durationMinutes
        || getAfter(slotPath(nthSlotId(b, i))).data.bookingId == id;
    }

    function slotsClaimed(b, id) {
      return slotClaimed(b, id, 0) && slotClaimed(b, id, 1)
        && slotClaimed(b, id, 2) && slotClaimed(b, id, 3);
    }

    // True if `b` has no i-th slot, or that slot no longer belongs to booking `id` afterwards.
    function slotReleased(b, id, i) {
      return i * 15 >= b.durationMinutes
        || !existsAfter(slotPath(nthSlotId(b, i)))
        || getAfter(slotPath(nthSlotId(b, i))).data.bookingId != id;
    }

    function slotsReleased(b, id) {
      return slotReleased(b, id, 0) && slotReleased(b, id, 1)
        && slotReleased(b, id, 2) && slotReleased(b, id, 3);
    }

    // True if `slotId` is one of the slots booking `b` occupies.
    function coversSlot(b, slotId) {
      return (b.durationMinutes > 0 && slotId == nthSlotId(b, 0))
        || (b.durationMinutes > 15 && slotId == nthSlotId(b, 1))
        || (b.durationMinutes > 30 && slotId == nthSlotId(b, 2))
        || (b.durationMinutes > 45 && slotId == nthSlotId(b, 3));
    }

    // startAt must be the shop's local date + time (Lebanon is UTC+2 in winter, UTC+3 in summer),
    // in the future, and on a day the booking page offers.
    function validStart(b) {
      let d = b.date.split('-');
      let day = timestamp.date(int(d[0]), int(d[1]), int(d[2]));
      let local = day + duration.value(minutesOf(b.startTime), 'm');
      return (b.startAt == local - duration.value(2, 'h') || b.startAt == local - duration.value(3, 'h'))
        && b.startAt > request.time
        && day <= request.time + duration.value(3, 'h') + duration.value(daysToShow() - 1, 'd');
    }

    // Seat n of `owner` in `collection` ends up pointing at booking `id`.
    function holdsSeat(collection, owner, id, n) {
      return getAfter(/databases/$(database)/documents/$(collection)/$(owner + '_' + string(n))).data.bookingId == id;
    }

    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 50 && name == name.trim();
    }

    function validPhone(phone) {
      return phone is string && phone.matches('^[+]961(3[0-9]{6}|(70|71|76|78|79|81)[0-9]{6})$');
    }

    function validCustomerBooking(id) {
      let b = request.resource.data;
      let fields = ['name', 'phone', 'serviceId', 'serviceName', 'date', 'startTime', 'startAt',
                    'durationMinutes', 'bookingCode', 'status', 'createdAt',
                    'customerUid', 'customerEmail'];
      return isCustomer()
        && b.keys().hasAll(fields) && b.keys().hasOnly(fields)
        && b.customerUid == request.auth.uid
        && b.customerEmail == request.auth.token.email
        && id.matches('^[A-HJ-NP-Z2-9]{6}$') && b.bookingCode == id
        && validName(b.name)
        && validPhone(b.phone)
        && b.serviceId is string && b.serviceId in services()
        && b.serviceName == services()[b.serviceId].name
        && b.durationMinutes == services()[b.serviceId].duration
        && b.date is string && b.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && b.startTime is string && b.startTime.matches('^([01][0-9]|2[0-3]):(00|15|30|45)$')
        && b.startAt is timestamp && validStart(b)
        && b.status == 'booked'
        && b.createdAt == request.time
        && slotsClaimed(b, id)
        && (holdsSeat('phoneLimits', b.phone, id, 1) || holdsSeat('phoneLimits', b.phone, id, 2))
        && (holdsSeat('userLimits', b.customerUid, id, 1) || holdsSeat('userLimits', b.customerUid, id, 2));
    }

    // Customer cancel: only their own booking, only "booked" -> "cancelled" with cancelledAt,
    // before the start, and its slots must be freed in the same transaction.
    function validCancel(id) {
      let before = resource.data;
      let after = request.resource.data;
      return ownsBooking(before)
        && before.status == 'booked'
        && request.time < before.startAt
        && after.diff(before).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && after.status == 'cancelled'
        && after.cancelledAt == request.time
        && slotsReleased(before, id);
    }

    // Taking a seat (see the top of this file): only for a booking created in this same write,
    // and only a seat of that booking's `ownerField` (its phone or customerUid). Overwriting an
    // existing seat is allowed only once it's free (its booking has started, or was cancelled /
    // marked done / no-show).
    function validSeatClaim(seatId, ownerField) {
      let seat = request.resource.data;
      let b = getAfter(bookingPath(seat.bookingId)).data;
      return seat.keys().hasAll(['bookingId', 'startAt'])
        && seat.keys().hasOnly(['bookingId', 'startAt'])
        && b.createdAt == request.time
        && (seatId == b[ownerField] + '_1' || seatId == b[ownerField] + '_2')
        && seat.startAt == b.startAt
        && (resource == null
            || resource.data.startAt <= request.time
            || get(bookingPath(resource.data.bookingId)).data.status != 'booked');
    }

    match /bookings/{bookingId} {
      // A customer may also get a code nobody uses yet (to pick a free one); that only
      // tells them the code is free, never anything about someone else's booking.
      allow get: if isAdmin() || (isCustomer() && (resource == null || ownsBooking(resource.data)));
      // Customers may only list with a `customerUid == their UID` filter.
      allow list: if isAdmin() || ownsBooking(resource.data);
      allow create: if isAdmin() || validCustomerBooking(bookingId);
      allow update: if isAdmin() || validCancel(bookingId);
      allow delete: if false;
    }

    match /slots/{slotId} {
      allow read: if true;

      // Only for a booking created in this same write (its createdAt is this request's time).
      // A slot that already exists can't be "created": that write is an update, which is denied.
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll(['bookingId', 'date'])
        && request.resource.data.keys().hasOnly(['bookingId', 'date'])
        && getAfter(bookingPath(request.resource.data.bookingId)).data.createdAt == request.time
        && getAfter(bookingPath(request.resource.data.bookingId)).data.date == request.resource.data.date
        && coversSlot(getAfter(bookingPath(request.resource.data.bookingId)).data, slotId)
      );

      allow update: if isAdmin();

      // Only when its booking goes from "booked" to "cancelled" in this same write.
      allow delete: if isAdmin() || (
        get(bookingPath(resource.data.bookingId)).data.status == 'booked'
        && getAfter(bookingPath(resource.data.bookingId)).data.status == 'cancelled'
      );
    }

    match /phoneLimits/{seatId} {
      // Customers can't read these: they hold booking codes of whoever used that phone.
      allow read: if isAdmin();
      allow create, update: if isCustomer() && validSeatClaim(seatId, 'phone');
    }

    match /userLimits/{seatId} {
      // A customer may read their own two seats, to pick a free one.
      allow get: if isAdmin()
        || (isCustomer() && (seatId == request.auth.uid + '_1' || seatId == request.auth.uid + '_2'));
      allow create, update: if isCustomer() && validSeatClaim(seatId, 'customerUid');
    }

    match /customers/{uid} {
      allow get: if isAdmin() || (isCustomer() && request.auth.uid == uid);
      allow create, update: if isCustomer() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name', 'phone', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && validName(request.resource.data.name)
        && validPhone(request.resource.data.phone)
        && request.resource.data.updatedAt == request.time;
    }

    // Everything else is denied.
  }
}
