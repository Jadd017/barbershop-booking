VITE_FIREBASE_API_KEY=
# The domain the site is served from (see README, "Customer sign-in"), not necessarily <project>.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (see README, "App Check"). The site key is public; leave empty to turn App Check off.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Only for `npm run dev`: a debug token registered in the Firebase console. Keep it secret.
VITE_APPCHECK_DEBUG_TOKEN=
